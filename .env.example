# ── Spotify Developer App ────────────────────────────────────────────────────
# Create one at https://developer.spotify.com/dashboard
# Add redirect URI: http://127.0.0.1:8888/callback
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# Scopes are always merged with required defaults in code:
# playlist-modify-public playlist-modify-private user-read-private user-read-email

# ── xAI (Grok) API ───────────────────────────────────────────────────────────
# Get a key at https://console.x.ai
# Docs: https://docs.x.ai
XAI_API_KEY=your_xai_api_key

# Optional: override default model (default: grok-4.5)
# XAI_MODEL=grok-4.5

# Optional: Google Books API key for higher rate limits
# https://developers.google.com/books/docs/v1/using#APIKey
# GOOGLE_BOOKS_API_KEY=

# Optional: tune defaults
# CHAPTERSCORE_TRACKS_PER_CHAPTER=3
# CHAPTERSCORE_TRACKS_OVERALL=20
# CHAPTERSCORE_CACHE_DIR=
